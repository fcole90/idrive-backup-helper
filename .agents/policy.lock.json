{
  "version": 1,
  "claude": {
    "deny": [
      "Read(*.env)",
      "Read(*.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.pub)",
      "Read(credentials.json)",
      "Read(secrets/)",
      "Read(internal-config.yml)"
    ]
  },
  "vscode": {
    "files.associations": {
      "*.env": "copilot-restricted-file",
      "*.env.*": "copilot-restricted-file",
      "*.pem": "copilot-restricted-file",
      "*.key": "copilot-restricted-file",
      "*.pub": "copilot-restricted-file",
      "credentials.json": "copilot-restricted-file",
      "secrets/": "copilot-restricted-file",
      "internal-config.yml": "copilot-restricted-file"
    },
    "github.copilot.enable": {
      "copilot-restricted-file": false
    },
    "chat.tools.terminal.autoApprove": {
      "/^git (log|status).*$/": true,
      "/^uv run poe (lint|lint-fix|typecheck|test)$/": true,
      "/^uv run (poe (sync-ai-policy|sync-ai-policy-import-vscode|policy-check)|agentic-tools policy (sync|import-vscode|check))$/": true,
      "rm": false,
      "rmdir": false,
      "del": false,
      "curl": false,
      "wget": false
    },
    "chat.tools.edits.autoApprove": {
      "**/*.{py,json,yml,yaml,css,md}": true,
      "**/.env*": false,
      "**/secrets/**": false,
      "**/.aiexclude": false,
      "**/.ai-policy.json": false,
      "**/*.{pem,key,pub}": false,
      "**/internal-config.yml": false
    }
  },
  "aiexclude": "sha256:8176c63be7dd9fecdfd098a0dee13593a6b2061398cead5430655e3cfa36afbb"
}
